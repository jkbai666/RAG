# Copy to .local/app.env. This file configures infrastructure only.
# Keep real database credentials private; setup preserves an existing app.env.
DB_URL=jdbc:mysql://127.0.0.1:13306/rag_mvp?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USERNAME=rag
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
CHROMA_BASE_URL=http://127.0.0.1:8000
# Cloud endpoints, model names, API keys, chunking and collection are configured in
# backend/src/main/resources/application.yml. Both API keys default to empty strings.
# setup/start do not download, launch or wait for local model servers.
